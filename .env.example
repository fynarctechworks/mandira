# Copy to .env.local and fill in. Never commit real values (CLAUDE.md §5).
# Local values come from `npx supabase status` — this project runs on the 544xx
# port range (D-026) because another Supabase stack holds the CLI defaults.

# ── Supabase (TRD §8.4) ───────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54421
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Bypasses RLS entirely — never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Auth providers ────────────────────────────────────────────────────────────
# Google OAuth client (Ops + traveler sign-in).
SUPABASE_AUTH_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_GOOGLE_SECRET=

# ── Email (magic links) ───────────────────────────────────────────────────────
# Local dev needs NONE of these: mail is captured by Mailpit at
# http://127.0.0.1:54424. Resend is required only for preview/production, and
# its sending domain must be verified before magic links work at all.
RESEND_API_KEY=

# ── Not yet used; listed so the file matches TRD §8.4 ─────────────────────────
GOOGLE_GENERATIVE_AI_API_KEY=
ANTHROPIC_API_KEY=
OPENROUTESERVICE_API_KEY=
NEXT_PUBLIC_MAPTILER_KEY=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
SENTRY_DSN=
CRON_SECRET=
