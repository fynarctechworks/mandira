# Copy to .env.local and fill in. Never commit real values (CLAUDE.md §5).
# Local values come from `npx supabase status` — this project runs on the 544xx
# port range (D-026) because another Supabase stack holds the CLI defaults.

# ── Supabase (TRD §8.4) ───────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54421
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Bypasses RLS entirely — never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Auth providers ────────────────────────────────────────────────────────────
# Google OAuth client (Ops + traveler sign-in).
SUPABASE_AUTH_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_GOOGLE_SECRET=

# ── Email ─────────────────────────────────────────────────────────────────────
# Local dev needs NONE of these: mail is captured by Mailpit at
# http://127.0.0.1:54424. Resend is required only for preview/production, and
# its sending domain must be verified before magic links work at all.
RESEND_API_KEY=
# The verified sender the app's own mail uses (`getEmailProvider`), e.g.
# "Mandhira <hello@your-domain>". Without it and the key, sends answer `not_configured`.
EMAIL_FROM=

# ── Geocoding ─────────────────────────────────────────────────────────────────
# Nominatim's usage policy requires an identifying User-Agent with contact details.
GEOCODING_USER_AGENT=

# ── AI (TRD §7.1) ─────────────────────────────────────────────────────────────
# Without a key the AI provider refuses up front rather than failing mid-request:
# a feature that needs an account nobody has set up yet should be absent, not broken.
# The fallback provider is simply dropped from the chain when its key is missing.
GOOGLE_GENERATIVE_AI_API_KEY=
ANTHROPIC_API_KEY=
# Defaults below are the TRD §7.1 values; set them only to override.
# AI_PROVIDER=google
# AI_FALLBACK_PROVIDER=anthropic     # "none" to run with no fallback
# AI_MODEL_FAST=gemini-2.5-flash-lite
# AI_MODEL_STRUCTURED=gemini-2.5-flash
# AI_MODEL_QUALITY=claude-sonnet-4-6
# AI_EMBED_MODEL=text-embedding-004
# AI_TIMEOUT_MS=12000
# AI_MAX_RETRIES=1

# ── Routing and maps ──────────────────────────────────────────────────────────
# Optional. Without it travel times are straight-line estimates, recorded as `estimated`
# in travel_estimates.provider; with it they are routed (D-105, D-159).
OPENROUTESERVICE_API_KEY=
# Not yet used (MAPS-02); listed so the file matches TRD §8.4.
NEXT_PUBLIC_MAPTILER_KEY=
# Web Push. Generate a pair with `pnpm push:keys`. Rotating them is NOT routine: every
# existing subscription is signed against the old pair, so a change silently stops
# notifications for everyone until each browser subscribes again.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
# The same public key, exposed to the browser — subscriptions are created client-side.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
SENTRY_DSN=

# Shared secret for the Vercel Cron routes. Without it a cron route returns 404 rather
# than running: an unauthenticated endpoint that touches the database is worth more to an
# attacker than to us. Any long random string; Vercel sends it as
# `Authorization: Bearer $CRON_SECRET`.
#
# BOTH apps need this and the service-role key. The traveler app runs the keepalive,
# notification and feed crons; the OPS app runs ingestion (`/api/cron/ingest`), which
# writes captures and change candidates under the service role because `captures` has no
# insert policy for `authenticated` (migration 0024). They deploy as separate Vercel
# projects, so each carries its own copy.
CRON_SECRET=
