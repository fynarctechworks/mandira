{
  "name": "mandhira",
  "private": true,
  "packageManager": "pnpm@10.30.3",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "turbo run build --concurrency=2",
    "dev": "turbo run dev",
    "lint": "turbo run lint --concurrency=2",
    "typecheck": "turbo run typecheck --concurrency=2",
    "test": "vitest run",
    "test:e2e": "node scripts/e2e.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:types": "bash scripts/gen-types.sh",
    "db:types:check": "bash scripts/gen-types.sh --check",
    "i18n:locales": "node scripts/generate-locales.mjs",
    "i18n:locales:check": "node scripts/generate-locales.mjs --check",
    "db:test": "supabase test db",
    "test:engine": "vitest run packages/journey-engine --coverage",
    "push:keys": "node scripts/generate-vapid-keys.mjs",
    "ui:add": "pnpm --filter @mandhira/ui exec shadcn add",
    "check:bundle": "node scripts/check-bundle.mjs apps/web",
    "preflight": "node scripts/preflight.mjs",
    "db:backup:verify": "bash scripts/backup-verify.sh",
    "test:smoke": "playwright test --config playwright.smoke.config.ts"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.2",
    "@playwright/test": "^1.55.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.6",
    "@vitest/coverage-v8": "^3.2.7",
    "jsdom": "^26.1.0",
    "prettier": "^3.6.2",
    "shadcn": "^4.19.0",
    "turbo": "^2.5.6",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4",
    "web-push": "^3.6.7"
  },
  "pnpm": {
    "overrides": {
      "js-yaml@>=4.0.0 <4.3.2": ">=4.3.2",
      "postcss@<8.5.23": ">=8.5.23",
      "browserslist@<4.28.7": ">=4.28.7",
      "sharp@<0.35.4": ">=0.35.4"
    }
  }
}
